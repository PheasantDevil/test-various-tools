# GitHub API設定
# GitHubのPersonal Access Tokenを設定してください
# 必要なスコープ: repo, read:org, user
REACT_APP_GITHUB_TOKEN=

# Slack API設定
# SlackのBot User OAuth Tokenを設定してください (xoxb-で始まるもの)
# 必要なスコープ: channels:read, channels:history, chat:write, users:read, auth:test
REACT_APP_SLACK_TOKEN=

# その他の設定
FAST_REFRESH=false