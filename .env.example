# GitHub API設定
# GitHubのPersonal Access Tokenを設定してください
# 必要なスコープ: repo, read:org, user
REACT_APP_GITHUB_TOKEN=

# Slack API設定
# SlackのBot User OAuth Tokenを設定してください (xoxb-で始まるもの)
# 必要なスコープ: channels:read, channels:history, chat:write, users:read, auth:test
REACT_APP_SLACK_TOKEN=

# Slack Webhook設定
# Slack Incoming Webhook URLを設定してください
# 形式: https://hooks.slack.com/services/XXXXXXXXX/YYYYYYYYY/ZZZZZZZZZZZZZZZZZZZZZZZZ
REACT_APP_SLACK_WEBHOOK_URL=

# TimeTree API設定（オプション）
# TimeTreeのAPIエンドポイント
REACT_APP_TIMETREE_API=https://timetreeapis.com
# TimeTreeのパーソナルアクセストークン
REACT_APP_TIMETREE_PERSONAL_ACCESSTOKEN=

# React開発設定
# 高速リフレッシュの有効/無効
FAST_REFRESH=false