{
  "name": "test-various-tools",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://pheasantdevil.github.io/test-various-tools/",
  "proxy": "https://slack.com",
  "scripts": {
    "prestart": "node scripts/check-env.js",
    "start": "craco start",
    "prebuild": "node scripts/check-env.js",
    "build": "craco build",
    "test": "craco test --verbose --transformIgnorePatterns \"node_modules/(?!@testing-library)/\" --testEnvironment=jsdom",
    "test:env": "node scripts/test-env.js",
    "test:coverage": "craco test --coverage --watchAll=false --transformIgnorePatterns \"node_modules/(?!@testing-library)/\" --testEnvironment=jsdom",
    "test:ci": "craco test --watchAll=false --ci --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx src/",
    "lint:fix": "eslint --ext .js,.jsx,.ts,.tsx src/ --fix",
    "watch": "tsc --watch",
    "rm": "rm -rf docs",
    "mv": "mv build _site",
    "git": "git add . && git commit && git push origin develop",
    "preDeploy": "npm run rm && npm run build && npm run mv",
    "deploy": "npm run rm && npm run build && npm run mv && npm run git",
    "eject": "react-scripts eject",
    "prepare": "husky install",
    "update-sass": "node scripts/update-sass-imports.js"
  },
  "devDependencies": {
    "@babel/core": "7.26.9",
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@craco/craco": "^7.1.0",
    "@pmmmwh/react-refresh-webpack-plugin": "0.6.2",
    "@svgr/webpack": "8.1.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "29.5.14",
    "@types/node": "20.19.40",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.5",
    "babel-jest": "29.7.0",
    "babel-loader": "10.0.0",
    "babel-plugin-named-asset-import": "0.3.8",
    "babel-preset-react-app": "10.1.0",
    "bfj": "9.1.3",
    "browserslist": "4.28.2",
    "camelcase": "9.0.0",
    "case-sensitive-paths-webpack-plugin": "2.4.0",
    "css-loader": "7.1.4",
    "css-minimizer-webpack-plugin": "7.0.4",
    "dotenv": "17.2.3",
    "dotenv-expand": "12.0.3",
    "eslint": "9.23.0",
    "eslint-config-react-app": "7.0.1",
    "eslint-webpack-plugin": "5.0.0",
    "file-loader": "6.2.0",
    "fs-extra": "11.3.5",
    "gh-pages": "6.3.0",
    "graphql-request": "^7.3.5",
    "html-webpack-plugin": "5.6.7",
    "husky": "^9.1.7",
    "identity-obj-proxy": "3.0.0",
    "jest": "29.7.0",
    "jest-resolve": "29.7.0",
    "jest-watch-typeahead": "3.0.1",
    "mini-css-extract-plugin": "2.9.4",
    "msw": "^2.12.3",
    "postcss": "8.5.14",
    "postcss-flexbugs-fixes": "5.0.2",
    "postcss-loader": "8.2.1",
    "postcss-normalize": "13.0.1",
    "postcss-preset-env": "10.4.0",
    "prettier": "3.5.3",
    "prompts": "2.4.2",
    "react": "18.3.1",
    "react-app-polyfill": "3.0.0",
    "react-dev-utils": "12.0.1",
    "react-dom": "18.3.1",
    "react-hook-form": "^7.67.0",
    "react-refresh": "0.17.0",
    "react-scripts": "5.0.1",
    "resolve": "1.22.12",
    "resolve-url-loader": "5.0.0",
    "sass": "^1.86.0",
    "sass-loader": "16.0.7",
    "semver": "7.7.4",
    "source-map-loader": "5.0.0",
    "style-loader": "4.0.0",
    "tailwindcss": "4.0.17",
    "terser-webpack-plugin": "5.3.14",
    "typescript": "5.9.3",
    "web-vitals": "5.1.0",
    "webpack": "5.103.0",
    "webpack-dev-server": "5.2.3",
    "webpack-manifest-plugin": "6.0.1",
    "workbox-webpack-plugin": "7.4.0"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "babel": {
    "presets": [
      "react-app"
    ]
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^7.3.5",
    "@octokit/rest": "^22.0.1",
    "@slack/web-api": "^7.13.0",
    "axios": "^1.13.2",
    "react-router-dom": "^7.9.6"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
